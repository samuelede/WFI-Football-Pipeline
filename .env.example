FOOTBALL_API_KEY=your_football_data_org_api_key
FOOTBALL_API_BASE_URL=https://api.football-data.org/v4
COMPETITION_CODE=WC

GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET_NAME=wfi-football-raw-data
SERVICE_ACCOUNT_PATH=service_account.json

RAW_DATASET=wfi_raw
STAGING_DATASET=wfi_staging
GOLD_DATASET=wfi_gold

LOCAL_DATA_DIR=data/raw

# Data quality gate: fails the transform DAG if stg_matches has fewer rows than this
MIN_STAGING_ROW_COUNT=10

# Email alerting (optional). Leave ALERT_EMAIL_TO blank to skip the notify task entirely.
# For Gmail: use an App Password, not your normal password, and enable 2FA first.
ALERT_EMAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_MAIL_FROM=your_email@gmail.com
